#!/usr/bin/env bash
# firepot: single-script Linux host health check with JSON output,
# meaningful exit codes, and multi-node SSH aggregation.
# Formerly node-healthcheck; bin/node-healthcheck remains as a deprecated alias.
#
# Exit codes: 0 healthy, 1 warning, 2 critical, 3 usage or runtime error.
#
# Copyright (c) 2026 Greyforge (https://greyforge.tech)
# SPDX-License-Identifier: AGPL-3.0-only

# Checks are dispatched dynamically as "check_$name", which shellcheck cannot follow.
# shellcheck disable=SC2329,SC2317

set -euo pipefail
# Parse every probe's output in one predictable locale.
export LC_ALL=C

NHC_VERSION="1.3.0"

# Any exit that does not go through finish() is an unexpected runtime error,
# which the exit-code contract reports as 3 (never as a health state).
# Fleet mode keeps per-host results in FP_TMP, which every exit removes.
FP_DONE=0
FP_TMP=""
trap '[[ -z "$FP_TMP" ]] || rm -rf -- "$FP_TMP"; (( FP_DONE )) || { echo "firepot: unexpected runtime error" >&2; exit 3; }' EXIT
# A reader that goes away (firepot | head) ends the run the way it ends any
# filter: killed by SIGPIPE, without an error message. Writes to stdout go
# through out(), which hides the shell's "write error" line for the same reason.
trap 'FP_DONE=1; trap - PIPE; kill -PIPE "$$"' PIPE
# shellcheck disable=SC2034  # read by the EXIT trap
finish() { FP_DONE=1; exit "$1"; }
# shellcheck disable=SC2059  # out() takes printf's format as its first argument
out() { printf "$@" 2>/dev/null; }

# Deprecated alias: the tool was called node-healthcheck before 1.2.0, and that
# name keeps working for now. Invoking it through the old name prints one note
# to stderr (never stdout) and then behaves identically. Fleet mode streams
# this file to each remote over "bash -s", where $0 is the remote shell rather
# than this file, so remote runs never print the note and remote reports stay clean.
if [[ "${0##*/}" == "node-healthcheck" ]]; then
    echo "node-healthcheck: deprecated name; this tool is now firepot and the old name will be removed in a future release" >&2
fi

# Roots are overridable so the check logic can be exercised against fixtures.
# FIREPOT_* wins; the pre-rename NODE_HEALTHCHECK_* names remain as fallbacks.
PROC_ROOT="${FIREPOT_PROC:-${NODE_HEALTHCHECK_PROC:-/proc}}"
FS_ROOT="${FIREPOT_ROOT:-${NODE_HEALTHCHECK_ROOT:-}}"
# Deadline for df, so a hung mount is reported instead of hanging the run.
PROBE_TIMEOUT="${FIREPOT_PROBE_TIMEOUT:-10}"

ALL_CHECKS="system load memory swap disk inodes network gateway dns services user_services ports peers failed_units time_sync reboot_required sessions zombies"

# Thresholds (percent used unless noted). Load thresholds are multiples of core count.
WARN_LOAD="1.0"; CRIT_LOAD="2.0"
WARN_MEM="80";  CRIT_MEM="95"
WARN_SWAP="50"; CRIT_SWAP="90"
WARN_DISK="80"; CRIT_DISK="90"
WARN_INODES="80"; CRIT_INODES="90"
WARN_ZOMBIES="5"; CRIT_ZOMBIES="50"

SERVICES=""; USER_SERVICES=""; PORTS=""; PEERS=""; DNS=""; MOUNTS=""
CHECKS=""; SKIP=""; HOSTS=""
JSON=0; QUIET=0; COLOR=1; PING_TIMEOUT="1"; SSH_TIMEOUT="10"; SSH_OPTS=""; PARALLEL="8"

# Config keys; each sets the variable of the same name in upper case, and each
# except checks and hosts is also a long option (warn_load <-> --warn-load).
KEYS="services user_services ports peers dns mounts checks skip hosts ssh_opts ssh_timeout ping_timeout parallel"
KEYS+=" warn_load crit_load warn_mem crit_mem warn_swap crit_swap warn_disk crit_disk warn_inodes crit_inodes warn_zombies crit_zombies"
is_key() { [[ " $KEYS " == *" $1 "* ]]; }

usage() {
    cat <<USAGE
firepot ${NHC_VERSION}

Usage: firepot [options]

Output:
  --json                 Emit a JSON document instead of text
  --quiet                Text mode: print only warn/crit checks and the summary
  --no-color             Disable ANSI colours in text mode

Selection:
  --check LIST           Comma-separated checks to run (default: all)
  --skip LIST            Comma-separated checks to skip
  --config FILE          key=value config file (see examples/firepot.conf)

Targets:
  --services LIST        systemd system units expected active
  --user-services LIST   systemd user units expected active
  --ports LIST           TCP ports expected to be listening
  --peers LIST           Hosts expected to answer ping
  --dns NAME             Hostname that must resolve
  --mounts LIST          Mount points to check (default: all local filesystems)
  --host HOST            Run remotely over SSH (repeatable; implies aggregation)
  --ssh-opts "OPTS"      Extra ssh options for --host
  --ssh-timeout SECONDS  ssh ConnectTimeout, whole seconds (default: ${SSH_TIMEOUT})
  --parallel N           Hosts queried at once with --host (default: ${PARALLEL})
  --ping-timeout SECONDS ping wait per peer (default: ${PING_TIMEOUT})

Thresholds:
  --warn-load N --crit-load N        load1 per core (default ${WARN_LOAD} / ${CRIT_LOAD})
  --warn-mem % --crit-mem %          memory used (default ${WARN_MEM} / ${CRIT_MEM})
  --warn-swap % --crit-swap %        swap used (default ${WARN_SWAP} / ${CRIT_SWAP})
  --warn-disk % --crit-disk %        disk used (default ${WARN_DISK} / ${CRIT_DISK})
  --warn-inodes % --crit-inodes %    inodes used (default ${WARN_INODES} / ${CRIT_INODES})
  --warn-zombies N --crit-zombies N  zombie processes (default ${WARN_ZOMBIES} / ${CRIT_ZOMBIES})

Checks: ${ALL_CHECKS}

Exit codes: 0 healthy, 1 warning, 2 critical, 3 usage or runtime error.
USAGE
}

die() { echo "firepot: $*" >&2; finish 3; }

# ── Config file (parsed, never sourced) ──────────────────────────────────────

load_config() {
    local file="$1" line key value
    [[ -r "$file" ]] || die "cannot read config file: $file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" == *=* ]] || die "config line is not key=value: $line"
        key="${line%%=*}"; value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%\"}"; value="${value#\"}"
        is_key "$key" || die "unknown config key: $key"
        printf -v "${key^^}" '%s' "$value"
    done < "$file"
}

# ── Argument parsing ─────────────────────────────────────────────────────────

need_value() { [[ $# -ge 2 ]] || die "$1 requires a value"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; finish 0 ;;
        -V|--version) echo "firepot ${NHC_VERSION}"; finish 0 ;;
        --json) JSON=1 ;;
        --quiet) QUIET=1 ;;
        --no-color) COLOR=0 ;;
        --config) need_value "$@"; load_config "$2"; shift ;;
        --check) need_value "$@"; CHECKS="$2"; shift ;;
        --host) need_value "$@"; HOSTS="${HOSTS:+$HOSTS,}$2"; shift ;;
        --?*)
            key="${1#--}"; key="${key//-/_}"
            if [[ "$1" == *_* || "$key" == checks || "$key" == hosts ]] || ! is_key "$key"; then die "unknown option: $1 (see --help)"; fi
            need_value "$@"; printf -v "${key^^}" '%s' "$2"; shift ;;
        --) shift; break ;;
        -*) die "unknown option: $1 (see --help)" ;;
        *) die "unexpected argument: $1" ;;
    esac
    shift
done
[[ $# -eq 0 ]] || die "unexpected argument: $1"

is_int() { [[ "$1" =~ ^[0-9]+$ ]]; }
# A JSON number literal (no leading zeros), which record() can emit unquoted.
is_json_number() { [[ "$1" =~ ^-?(0|[1-9][0-9]*)([.][0-9]+)?$ ]]; }

# Thresholds are compared with exact integer arithmetic, so they are bounded to
# nine integer and nine fractional digits.
for v in WARN_LOAD CRIT_LOAD WARN_MEM CRIT_MEM WARN_SWAP CRIT_SWAP WARN_DISK CRIT_DISK \
         WARN_INODES CRIT_INODES PING_TIMEOUT SSH_TIMEOUT PROBE_TIMEOUT; do
    [[ "${!v}" =~ ^-?[0-9]{1,9}([.][0-9]{1,9})?$ ]] || die "$v must be numeric, got '${!v}'"
done
# timeout(1) rejects a negative deadline, which would read as "no filesystems found".
[[ "$PROBE_TIMEOUT" != -* ]] || die "FIREPOT_PROBE_TIMEOUT must not be negative, got '$PROBE_TIMEOUT'"
for v in WARN_ZOMBIES CRIT_ZOMBIES; do
    [[ "${!v}" =~ ^[0-9]{1,18}$ ]] || die "$v must be an integer, got '${!v}'"
done
# ping -W 0 waits forever and rejects a negative wait, which would read as an
# unreachable peer. ssh takes whole seconds and treats 0 as no timeout at all.
[[ "$PING_TIMEOUT" != -* && "$PING_TIMEOUT" == *[1-9]* ]] || die "--ping-timeout must be above 0, got '$PING_TIMEOUT'"
[[ "$SSH_TIMEOUT" =~ ^[0-9]+$ && "$SSH_TIMEOUT" == *[1-9]* ]] || die "--ssh-timeout must be a whole number of seconds above 0, got '$SSH_TIMEOUT'"
[[ "$PARALLEL" =~ ^[1-9][0-9]{0,3}$ ]] || die "--parallel must be a whole number from 1 to 9999, got '$PARALLEL'"

# ── Check selection ──────────────────────────────────────────────────────────

# split_list LIST: comma or whitespace separated -> LIST array, blanks dropped.
# Items are never glob-expanded.
split_list() {
    local IFS=$', \t\n' item items=()
    read -r -d '' -a items <<< "$1" || true
    LIST=()
    for item in "${items[@]+"${items[@]}"}"; do [[ -z "$item" ]] || LIST+=("$item"); done
}

known_check() { [[ " $ALL_CHECKS " == *" $1 "* ]]; }

SELECTED=()
if [[ -n "$CHECKS" ]]; then
    split_list "$CHECKS"
    for c in "${LIST[@]+"${LIST[@]}"}"; do
        known_check "$c" || die "unknown check: $c"
        SELECTED+=("$c")
    done
else
    read -r -a SELECTED <<< "$ALL_CHECKS"
fi
if [[ -n "$SKIP" ]]; then
    split_list "$SKIP"
    for s in "${LIST[@]+"${LIST[@]}"}"; do known_check "$s" || die "unknown check in --skip: $s"; done
    skipped=" ${LIST[*]+"${LIST[*]}"} "; filtered=()
    for c in "${SELECTED[@]+"${SELECTED[@]}"}"; do [[ "$skipped" == *" $c "* ]] || filtered+=("$c"); done
    SELECTED=("${filtered[@]+"${filtered[@]}"}")
fi

# ── JSON helpers (no jq dependency, no subshells) ────────────────────────────

# Control characters other than \n \r \t are rare in this output and are
# dropped rather than emitted raw. (Bash strings cannot hold NUL.)
CTRL=$'\001\002\003\004\005\006\007\010\013\014\016\017\020\021\022\023\024\025\026\027\030\031\032\033\034\035\036\037'

# jstr STRING: REPLY = STRING as a JSON string literal.
jstr() {
    local s="${1//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    REPLY="\"${s//["$CTRL"]/}\""
}

# ── Result accumulation ──────────────────────────────────────────────────────

CHECK_JSON=()
OVERALL=0            # 0 ok, 1 warn, 2 crit
WORST_STATUS="ok"
LEVELS=(ok warn crit)

# paint STATUS: C and R = ANSI colour and reset for STATUS (empty without colour).
paint() {
    C=""; R=""
    (( COLOR )) || return 0
    R=$'\033[0m'
    case "$1" in
        ok) C=$'\033[32m' ;; warn) C=$'\033[33m' ;; crit) C=$'\033[31m' ;;
        info) C=$'\033[36m' ;; skip) C=$'\033[90m' ;;
    esac
}

# record NAME STATUS SUMMARY [metric ...]
# A metric is key=NUMBER (split at the last "=", so keys such as mount points
# may contain "=") or +key=STRING (always emitted as a JSON string).
record() {
    local name="$1" status="$2" summary="$3" rank=0 kv key metrics="" value; shift 3
    case "$status" in warn) rank=1 ;; crit) rank=2 ;; esac
    if (( rank > OVERALL )); then OVERALL=$rank; WORST_STATUS="$status"; fi

    for kv in "$@"; do
        if [[ "$kv" == +* ]]; then
            key="${kv%%=*}"; key="${key#+}"; jstr "${kv#*=}"; value="$REPLY"
        else
            key="${kv%=*}"; value="${kv##*=}"
            if ! is_json_number "$value"; then jstr "$value"; value="$REPLY"; fi
        fi
        jstr "$key"
        metrics+="${metrics:+,}$REPLY:$value"
    done
    local entry
    jstr "$name"; entry="{\"name\":$REPLY"
    jstr "$status"; entry+=",\"status\":$REPLY"
    jstr "$summary"; entry+=",\"summary\":$REPLY,\"metrics\":{${metrics}}}"
    CHECK_JSON+=("$entry")

    if (( ! JSON )); then
        if (( QUIET )) && [[ "$status" != "warn" && "$status" != "crit" ]]; then return 0; fi
        paint "$status"
        out '%s[%-4s]%s %-16s %s\n' "$C" "${status^^}" "$R" "$name" "$summary"
    fi
}

# dec_ge A B: true when decimal A >= decimal B, exactly, in integer arithmetic.
# Inputs are validated decimals with at most 9 integer and 9 fractional digits.
dec_ge() {
    local a="${1#-}" b="${2#-}" sa=1 sb=1 af="" bf=""
    [[ "$1" != -* ]] || sa=-1
    [[ "$2" != -* ]] || sb=-1
    [[ "$a" != *.* ]] || af="${a#*.}"
    [[ "$b" != *.* ]] || bf="${b#*.}"
    while (( ${#af} < ${#bf} )); do af+="0"; done
    while (( ${#bf} < ${#af} )); do bf+="0"; done
    (( sa * 10#${a%%.*}$af >= sb * 10#${b%%.*}$bf ))
}

# level VALUE WARN CRIT: LEVEL = ok|warn|crit (higher is worse), RANK = 0|1|2.
level() {
    RANK=0
    if dec_ge "$1" "$3"; then RANK=2; elif dec_ge "$1" "$2"; then RANK=1; fi
    LEVEL="${LEVELS[RANK]}"
}

# pct1 USED TOTAL: REPLY = USED/TOTAL as a percentage with one decimal, rounded half up.
pct1() {
    local t=$(( ($1 * 2000 / $2 + 1) / 2 ))
    REPLY="$(( t / 10 )).$(( t % 10 ))"
}

has() { command -v "$1" >/dev/null 2>&1; }

# Optional deadline prefix for probes that can block on a hung filesystem.
# Probe output is captured as { var="$(cmd)"; } 2>/dev/null rather than with a
# redirection inside the substitution, which lets bash exec cmd without an extra fork.
DEADLINE=()
if has timeout; then DEADLINE=(timeout -k 2 "$PROBE_TIMEOUT"); fi

# The kernel exposes these directly; the commands are fallbacks for odd roots.
HOST=""
host_name() {
    [[ -z "$HOST" ]] || return 0
    { read -r HOST < "$PROC_ROOT/sys/kernel/hostname"; } 2>/dev/null || true
    [[ -n "$HOST" ]] || { HOST="$(hostname)"; } 2>/dev/null || true
    [[ -n "$HOST" ]] || HOST=unknown
}

now_utc() {
    if (( BASH_VERSINFO[0] > 4 || BASH_VERSINFO[1] >= 2 )); then
        TZ=UTC0 printf -v NOW '%(%Y-%m-%dT%H:%M:%SZ)T' -1
    else
        NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi
}

# ── Checks ───────────────────────────────────────────────────────────────────

check_system() {
    local kernel="" up="" s d h m uptime_h
    host_name
    { read -r kernel < "$PROC_ROOT/sys/kernel/osrelease"; } 2>/dev/null || true
    [[ -n "$kernel" ]] || { kernel="$(uname -r)"; } 2>/dev/null || true
    [[ -n "$kernel" ]] || kernel=unknown
    { read -r up _ < "$PROC_ROOT/uptime"; } 2>/dev/null || true
    s="${up%%.*}"; is_int "$s" || s=0
    d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
    if (( d > 0 )); then uptime_h="${d}d ${h}h ${m}m"; elif (( h > 0 )); then uptime_h="${h}h ${m}m"; else uptime_h="${m}m"; fi
    record system ok "$HOST, kernel $kernel, up $uptime_h" "+hostname=$HOST" "+kernel=$kernel" "uptime_seconds=$s"
}

# Online CPUs from sysfs ("0-3,6,8-11"). nproc is only a fallback: it reports the
# caller's affinity mask and honours OMP_NUM_THREADS, neither of which bounds
# the system-wide load average.
cpu_count() {
    local online="" r
    CORES=0
    { read -r online < "$FS_ROOT/sys/devices/system/cpu/online"; } 2>/dev/null || true
    if [[ "$online" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]]; then
        local IFS=,
        for r in $online; do CORES=$(( CORES + 10#${r#*-} - 10#${r%-*} + 1 )); done
    else
        { CORES="$(OMP_NUM_THREADS='' OMP_THREAD_LIMIT='' nproc)"; } 2>/dev/null || true
    fi
    is_int "$CORES" && (( CORES > 0 )) || CORES=1
}

check_load() {
    local l1="" l5="" l15="" frac v per_core
    { read -r l1 l5 l15 _ < "$PROC_ROOT/loadavg"; } 2>/dev/null || true
    [[ "$l1" =~ ^[0-9]{1,9}([.][0-9]+)?$ ]] || { record load skip "loadavg unavailable"; return 0; }
    cpu_count
    frac="${l1#*.}00"; [[ "$l1" == *.* ]] || frac=00
    # load1 in hundredths, divided by cores and rounded half up to two decimals.
    v=$(( ( (10#${l1%%.*} * 100 + 10#${frac:0:2}) * 2 / CORES + 1) / 2 ))
    printf -v per_core '%d.%02d' $(( v / 100 )) $(( v % 100 ))
    level "$per_core" "$WARN_LOAD" "$CRIT_LOAD"
    record load "$LEVEL" "$l1 $l5 $l15 on $CORES cores (${per_core}/core)" "load1=$l1" "load5=$l5" "load15=$l15" "cores=$CORES" "load1_per_core=$per_core"
}

# One pass over /proc/meminfo for both memory and swap.
read_meminfo() {
    [[ -z "${MEM_TOTAL+set}" ]] || return 0
    MEM_TOTAL=""; MEM_AVAIL=""; SWAP_TOTAL=""; SWAP_FREE=""
    local k v
    while read -r k v _ || [[ -n "$k" ]]; do
        case "$k" in
            MemTotal:) MEM_TOTAL="$v" ;; MemAvailable:) MEM_AVAIL="$v" ;;
            SwapTotal:) SWAP_TOTAL="$v" ;; SwapFree:) SWAP_FREE="$v" ;;
        esac
    done < "$PROC_ROOT/meminfo"
}

# used_check NAME TOTAL_KB LEFT_KB LEFT_KEY WARN CRIT: percentage of TOTAL in use.
used_check() {
    if ! { is_int "$2" && is_int "$3" && (( $2 > 0 && $3 <= $2 )); }; then record "$1" skip "meminfo incomplete"; return 0; fi
    local used=$(( $2 - $3 ))
    pct1 "$used" "$2"
    level "$REPLY" "$5" "$6"
    record "$1" "$LEVEL" "${REPLY}% used ($(( used / 1024 )) MiB of $(( $2 / 1024 )) MiB)" "used_percent=$REPLY" "total_kb=$2" "$4=$3"
}

check_memory() {
    [[ -r "$PROC_ROOT/meminfo" ]] || { record memory skip "meminfo unavailable"; return 0; }
    read_meminfo
    used_check memory "$MEM_TOTAL" "$MEM_AVAIL" available_kb "$WARN_MEM" "$CRIT_MEM"
}

check_swap() {
    [[ -r "$PROC_ROOT/meminfo" ]] || { record swap skip "meminfo unavailable"; return 0; }
    read_meminfo
    if [[ -z "$SWAP_TOTAL" || "$SWAP_TOTAL" == 0 ]]; then record swap info "no swap configured" "total_kb=0"; return 0; fi
    used_check swap "$SWAP_TOTAL" "$SWAP_FREE" free_kb "$WARN_SWAP" "$CRIT_SWAP"
}

# check_fs_usage NAME DF_FLAG WARN CRIT UNIT: df -P for local filesystems (or --mounts).
check_fs_usage() {
    local name="$1" flag="$2" warn="$3" crit="$4" unit="$5"
    local worst=0 summary="" count=0 metrics=() lines=() line mount pct m out rc missing="" hung=""
    if [[ -n "$MOUNTS" ]]; then
        split_list "$MOUNTS"
        for m in "${LIST[@]+"${LIST[@]}"}"; do
            rc=0; { out="$("${DEADLINE[@]+"${DEADLINE[@]}"}" df -P "$flag" -- "$m")"; } 2>/dev/null || rc=$?
            line="${out#*$'\n'}"; line="${line%%$'\n'*}"
            if (( rc == 124 || rc == 137 )); then hung+="${hung:+, }$m"
            elif (( rc != 0 )) || [[ "$out" != *$'\n'* || -z "$line" ]]; then missing+="${missing:+, }$m"
            else lines+=("$line"); fi
        done
    else
        rc=0
        { out="$("${DEADLINE[@]+"${DEADLINE[@]}"}" df -P -l "$flag" -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs -x fuse.portal)"; } 2>/dev/null || rc=$?
        if (( rc == 124 || rc == 137 )); then
            record "$name" crit "df did not answer within ${PROBE_TIMEOUT}s" "timed_out=1"; return 0
        fi
        [[ "$out" != *$'\n'* ]] || mapfile -t lines <<< "${out#*$'\n'}"
    fi
    for line in "${lines[@]+"${lines[@]}"}"; do
        # Filesystem, three counts, use%, then the mount point, which may contain spaces.
        # A filesystem name with spaces falls back to a last-field mount point.
        if [[ "$line" =~ ^[^[:space:]]+[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+([0-9]+)%[[:space:]]+(.+)$ ]] \
            || [[ "$line" =~ [[:space:]]([0-9]+)%[[:space:]]+([^[:space:]]+)$ ]]; then
            pct="${BASH_REMATCH[1]}"; mount="${BASH_REMATCH[2]}"
        else
            continue
        fi
        count=$(( count + 1 ))
        level "$pct" "$warn" "$crit"
        metrics+=("${mount}=$(( 10#$pct ))")
        (( RANK <= worst )) || worst=$RANK
        [[ "$LEVEL" == ok ]] || summary+="${summary:+, }${mount} ${pct}%"
    done
    if [[ -n "$missing$hung" ]]; then
        worst=2
        [[ -z "$missing" ]] || summary+="${summary:+, }missing mount: $missing"
        [[ -z "$hung" ]] || summary+="${summary:+, }no answer within ${PROBE_TIMEOUT}s: $hung"
    elif (( count == 0 )); then
        record "$name" skip "no filesystems found"; return 0
    fi
    [[ -n "$summary" ]] || summary="$count filesystem(s) under ${warn}% $unit"
    record "$name" "${LEVELS[worst]}" "$summary" "${metrics[@]+"${metrics[@]}"}"
}

check_disk() { check_fs_usage disk "-k" "$WARN_DISK" "$CRIT_DISK" "used"; }
check_inodes() { check_fs_usage inodes "-i" "$WARN_INODES" "$CRIT_INODES" "inodes used"; }

check_network() {
    has ip || { record network skip "ip command unavailable"; return 0; }
    local out="" ifaces="" count=0 name addr
    { out="$(ip -4 -o addr show)"; } 2>/dev/null || true
    # "2: eth0    inet 203.0.113.5/24 brd ..."
    while read -r _ name _ addr _; do
        [[ -n "$addr" && "$addr" != 127.* ]] || continue
        count=$(( count + 1 ))
        ifaces+="${ifaces:+, }${name} ${addr}"
    done <<< "$out"
    if (( count == 0 )); then record network warn "no non-loopback IPv4 address" "interfaces=0"; else record network ok "$ifaces" "interfaces=$count"; fi
}

check_gateway() {
    has ip || { record gateway skip "ip command unavailable"; return 0; }
    local out="" words=() w prev="" gw="" dev="" routes=0
    { out="$(ip -4 route show default)"; } 2>/dev/null || true
    read -r -d '' -a words <<< "$out" || true
    # Only the first default route counts; multipath next hops follow it as "nexthop via ...".
    for w in "${words[@]+"${words[@]}"}"; do
        if [[ "$w" == default ]]; then routes=$(( routes + 1 )); (( routes == 1 )) || break; fi
        case "$prev" in
            via) [[ -n "$gw" ]] || gw="$w" ;;
            dev) [[ -n "$dev" ]] || dev="$w" ;;
        esac
        prev="$w"
    done
    (( routes > 0 )) || { record gateway warn "no default route"; return 0; }
    if [[ -z "$gw" ]]; then
        # Point-to-point default route (WireGuard, PPP): there is no next hop to ping.
        record gateway info "default route on ${dev:-unknown device} (no next hop)" "+interface=${dev:-unknown}"; return 0
    fi
    has ping || { record gateway skip "ping unavailable" "+gateway=$gw"; return 0; }
    if ping -c 1 -W "$PING_TIMEOUT" "$gw" >/dev/null 2>&1; then record gateway ok "$gw reachable" "+gateway=$gw" "reachable=1"
    else record gateway crit "$gw unreachable" "+gateway=$gw" "reachable=0"; fi
}

check_dns() {
    [[ -n "$DNS" ]] || { record dns skip "no --dns name configured"; return 0; }
    has getent || { record dns crit "getent unavailable for configured DNS target"; return 0; }
    local resolved=""
    { resolved="$(getent ahosts "$DNS")"; } 2>/dev/null || true
    resolved="${resolved%%[[:space:]]*}"
    if [[ -n "$resolved" ]]; then record dns ok "$DNS -> $resolved" "+name=$DNS" "+address=$resolved"
    else record dns crit "$DNS does not resolve" "+name=$DNS"; fi
}

# check_units NAME LIST [systemctl scope args]: one systemctl call for all units.
check_units() {
    local name="$1" list="$2"; shift 2
    split_list "$list"
    (( ${#LIST[@]} )) || { record "$name" skip "none configured"; return 0; }
    has systemctl || { record "$name" crit "systemctl unavailable for configured units"; return 0; }
    local units=("${LIST[@]}") states=() out="" i down="" up=0 metrics=()
    { out="$(systemctl "$@" is-active -- "${units[@]}")"; } 2>/dev/null || true
    [[ -z "$out" ]] || mapfile -t states <<< "$out"
    if (( ${#states[@]} != ${#units[@]} )); then
        # systemctl printed no per-unit answer (for example an invalid unit name): ask one at a time.
        states=()
        for i in "${units[@]}"; do
            if systemctl "$@" is-active --quiet -- "$i" 2>/dev/null; then states+=(active); else states+=(inactive); fi
        done
    fi
    for i in "${!units[@]}"; do
        case "${states[i]}" in
            active|reloading|refreshing) up=$(( up + 1 )); metrics+=("${units[i]}=1") ;;
            *) down+="${down:+, }${units[i]}"; metrics+=("${units[i]}=0") ;;
        esac
    done
    if [[ -z "$down" ]]; then record "$name" ok "$up/${#units[@]} active" "${metrics[@]}"
    else record "$name" crit "inactive: $down ($up/${#units[@]} active)" "${metrics[@]}"; fi
}

check_services() { check_units services "$SERVICES"; }
check_user_services() { check_units user_services "$USER_SERVICES" --user; }

check_ports() {
    split_list "$PORTS"
    (( ${#LIST[@]} )) || { record ports skip "none configured"; return 0; }
    local port open=" " out="" st addr missing="" up=0 total=0 metrics=()
    # No -H, which older iproute2 lacks; header lines are skipped by their first word.
    if has ss; then { out="$(ss -ltn)"; } 2>/dev/null || true
    elif has netstat; then { out="$(netstat -ltn)"; } 2>/dev/null || true
    else record ports crit "ss and netstat unavailable for configured ports"; return 0; fi
    while read -r st _ _ addr _; do
        case "$st" in State|Netid|Active|Proto|"") continue ;; esac
        open+="${addr##*:} "
    done <<< "$out"
    for port in "${LIST[@]}"; do
        if ! [[ "$port" =~ ^[0-9]{1,5}$ ]] || (( 10#$port > 65535 )); then die "invalid port: $port"; fi
        port=$(( 10#$port )); total=$(( total + 1 ))
        if [[ "$open" == *" $port "* ]]; then up=$(( up + 1 )); metrics+=("${port}=1")
        else missing+="${missing:+, }${port}"; metrics+=("${port}=0"); fi
    done
    if [[ -z "$missing" ]]; then record ports ok "$up/$total listening" "${metrics[@]}"
    else record ports crit "not listening: $missing ($up/$total)" "${metrics[@]}"; fi
}

check_peers() {
    split_list "$PEERS"
    (( ${#LIST[@]} )) || { record peers skip "none configured"; return 0; }
    has ping || { record peers crit "ping unavailable for configured peers"; return 0; }
    local peers=("${LIST[@]}") pids=() i down="" up=0 metrics=()
    # Ping every peer at once: a run costs one ping timeout, not one per peer.
    for i in "${peers[@]}"; do ping -c 1 -W "$PING_TIMEOUT" -- "$i" >/dev/null 2>&1 & pids+=("$!"); done
    for i in "${!peers[@]}"; do
        if wait "${pids[i]}"; then up=$(( up + 1 )); metrics+=("${peers[i]}=1")
        else down+="${down:+, }${peers[i]}"; metrics+=("${peers[i]}=0"); fi
    done
    if [[ -z "$down" ]]; then record peers ok "$up/${#peers[@]} reachable" "${metrics[@]}"
    else record peers crit "unreachable: $down ($up/${#peers[@]})" "${metrics[@]}"; fi
}

check_failed_units() {
    has systemctl || { record failed_units skip "systemctl unavailable"; return 0; }
    local out="" unit failed="" count=0
    { out="$(systemctl list-units --state=failed --no-legend --plain)"; } 2>/dev/null || true
    while read -r unit _; do
        [[ -n "$unit" ]] || continue
        count=$(( count + 1 )); failed+="${failed:+ }$unit"
    done <<< "$out"
    if (( count == 0 )); then record failed_units ok "no failed units" "count=0"
    else record failed_units warn "$count failed: $failed" "count=$count"; fi
}

check_time_sync() {
    has timedatectl || { record time_sync skip "timedatectl unavailable"; return 0; }
    local synced=""
    { synced="$(timedatectl show -p NTPSynchronized --value)"; } 2>/dev/null || true
    case "$synced" in
        yes) record time_sync ok "clock synchronized" "synchronized=1" ;;
        no) record time_sync warn "clock not synchronized" "synchronized=0" ;;
        *) record time_sync skip "timedatectl gave no answer" ;;
    esac
}

check_reboot_required() {
    local dir pkg pkgs=""
    for dir in "$FS_ROOT/var/run" "$FS_ROOT/run"; do
        [[ -e "$dir/reboot-required" ]] || continue
        if [[ -r "$dir/reboot-required.pkgs" ]]; then
            while read -r pkg || [[ -n "$pkg" ]]; do
                [[ -z "$pkg" ]] || pkgs+="${pkgs:+ }$pkg"
            done < "$dir/reboot-required.pkgs"
        fi
        record reboot_required warn "reboot required${pkgs:+ ($pkgs)}" "required=1"; return 0
    done
    record reboot_required ok "no reboot pending" "required=0"
}

# Count the lines of a string without spawning wc or grep.
line_count() {
    if [[ -z "$1" ]]; then REPLY=0; else local nl="${1//[!$'\n']/}"; REPLY=$(( ${#nl} + 1 )); fi
}

check_sessions() {
    has who || { record sessions skip "who unavailable"; return 0; }
    local out=""
    { out="$(who)"; } 2>/dev/null || true
    line_count "$out"
    record sessions info "$REPLY login session(s)" "count=$REPLY"
}

check_zombies() {
    [[ -d "$PROC_ROOT" ]] || { record zombies skip "proc unavailable"; return 0; }
    local out="" rc=0
    # One grep over every status file; it exits 2 when a process vanishes mid-scan, which is harmless.
    if has grep; then out="$(grep -sh '^State:[[:space:]]*Z' "$PROC_ROOT"/[0-9]*/status)" || rc=$?; else rc=127; fi
    # Not runnable at all (no grep, or an argument list too long for exec).
    (( rc <= 2 )) || { record zombies skip "process table unreadable"; return 0; }
    line_count "$out"; local count=$REPLY
    level "$count" "$WARN_ZOMBIES" "$CRIT_ZOMBIES"
    record zombies "$LEVEL" "$count zombie process(es)" "count=$count"
}

# ── Local run ────────────────────────────────────────────────────────────────

run_local() {
    local c
    host_name
    if (( ! JSON )); then
        now_utc
        out 'firepot %s - %s - %s\n\n' "$NHC_VERSION" "$HOST" "$NOW"
    fi
    for c in "${SELECTED[@]+"${SELECTED[@]}"}"; do "check_$c"; done
    if (( JSON )); then
        local joined="" item
        for item in "${CHECK_JSON[@]+"${CHECK_JSON[@]}"}"; do joined+="${joined:+,}$item"; done
        now_utc; jstr "$HOST"
        # The "node-healthcheck" version key predates the rename and is kept for
        # existing consumers and mixed-version fleets.
        out '{"node-healthcheck":"%s","host":%s,"timestamp":"%s","status":"%s","exit_code":%d,"checks":[%s]}\n' \
            "$NHC_VERSION" "$REPLY" "$NOW" "$WORST_STATUS" "$OVERALL" "$joined"
    else
        paint "$WORST_STATUS"
        out '\nOverall: %s%s%s (exit %d)\n' "$C" "${WORST_STATUS^^}" "$R" "$OVERALL"
    fi
    finish "$OVERALL"
}

# ── Multi-node run ───────────────────────────────────────────────────────────

# REMOTE_ARGS: the effective settings (flags and config file alike) as flags, plus --json.
remote_args() {
    local args=() key var
    for key in $KEYS; do
        var="${key^^}"
        case "$key" in hosts|ssh_*|parallel) continue ;; checks) key=check ;; esac
        [[ -z "${!var}" ]] || args+=("--${key//_/-}" "${!var}")
    done
    printf -v REMOTE_ARGS '%q ' "${args[@]}" --json
}

# Reads one remote report from stdin, bounded to 1 MiB. Exit 0 prints the
# report's exit code, the report as compact JSON, then (text mode) one line
# per warn/crit check; exit 1 means no output at all, exit 2 an invalid report.
VALIDATOR='
import json, sys
raw = sys.stdin.buffer.read(1048577)
if not raw.strip():
    sys.exit(1)
def reject(_):
    raise ValueError
try:
    if len(raw) > 1048576:
        raise ValueError
    d = json.loads(raw, parse_constant=reject)
    ok = (isinstance(d, dict)
          and d.get("node-healthcheck", d.get("firepot")) == sys.argv[1]
          and isinstance(d.get("host"), str)
          and d.get("status") in ("ok", "warn", "crit")
          and type(d.get("exit_code")) is int
          and d["exit_code"] == ("ok", "warn", "crit").index(d["status"])
          and isinstance(d.get("checks"), list)
          and all(isinstance(c, dict)
                  and isinstance(c.get("name"), str)
                  and c.get("status") in ("ok", "warn", "crit", "info", "skip")
                  and isinstance(c.get("summary"), str)
                  for c in d["checks"]))
except (UnicodeError, ValueError):
    ok = False
if not ok:
    sys.exit(2)
print(d["exit_code"])
print(json.dumps(d, separators=(",", ":"), ensure_ascii=False))
if sys.argv[2] == "0":
    clean = lambda s: "".join(ch if ch.isprintable() else "?" for ch in s)
    for c in d["checks"]:
        if c["status"] in ("warn", "crit"):
            print("    [%s] %s: %s" % (c["status"], clean(c["name"]), clean(c["summary"])))
'

# query_host HOST OUT ERR: one remote run, as a background job. The report
# streams straight into the bounded validator, so a runaway remote cannot fill
# memory here. OUT gets the validator's output and a last line holding the ssh
# and validator exit codes; ERR gets ssh's stderr, which includes the remote's.
# ServerAlive* ends dead connections; ssh keeps the first value given, so
# --ssh-opts can override those two.
query_host() (
    set +e
    ssh -o BatchMode=yes -o ConnectTimeout="$SSH_TIMEOUT" "${SSH_ARGS[@]+"${SSH_ARGS[@]}"}" \
        -o ServerAliveInterval="$SSH_TIMEOUT" -o ServerAliveCountMax=3 \
        -- "$1" "bash -s -- $REMOTE_ARGS" < "$SCRIPT_FILE" 2> "$3" \
        | python3 -c "$VALIDATOR" "$NHC_VERSION" "$JSON" > "$2"
    printf '\n%s %s' "${PIPESTATUS[@]}" >> "$2"
)

# err_detail FILE: REPLY = the last non-blank line of FILE (ssh's own message,
# or the remote's last error), stripped of control characters and capped.
err_detail() {
    local text="" line
    REPLY=""
    [[ -s "$1" ]] || return 0
    if has tail; then { text="$(tail -c 4096 -- "$1")"; } 2>/dev/null || true
    else read -r -N 4096 text < "$1" || true; fi
    while IFS= read -r line; do
        line="${line//[$'\t\r']/ }"; line="${line//["$CTRL"]/}"
        [[ -z "${line//[[:space:]]/}" ]] || REPLY="$line"
    done <<< "$text"
    REPLY="${REPLY#"${REPLY%%[![:space:]]*}"}"; REPLY="${REPLY%"${REPLY##*[![:space:]]}"}"
    (( ${#REPLY} <= 300 )) || REPLY="${REPLY:0:300}..."
}

run_remote() {
    has ssh || die "ssh is required for --host"
    has python3 || die "python3 is required on the originating host for --host report validation"
    SCRIPT_FILE="${BASH_SOURCE[0]:-}"
    [[ -f "$SCRIPT_FILE" && -r "$SCRIPT_FILE" ]] || die "--host needs firepot to run from a readable file"
    FP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/firepot.XXXXXX")" || die "cannot create a temporary directory"
    local hosts=() i running=0 result body rc src vrc nodes="" node_status worst=0 worst_status="ok" error detail details
    read -r -a SSH_ARGS <<< "$SSH_OPTS"
    remote_args
    split_list "$HOSTS"
    hosts=("${LIST[@]+"${LIST[@]}"}")
    # Up to PARALLEL hosts at once; bash before 4.3 has no "wait -n" and waits per batch.
    for i in "${!hosts[@]}"; do
        if (( running >= PARALLEL )); then
            if (( BASH_VERSINFO[0] > 4 || BASH_VERSINFO[1] >= 3 )); then wait -n || true; running=$(( running - 1 ))
            else wait || true; running=0; fi
        fi
        query_host "${hosts[i]}" "$FP_TMP/$i.out" "$FP_TMP/$i.err" &
        running=$(( running + 1 ))
    done
    wait || true
    for i in "${!hosts[@]}"; do
        result=""; IFS= read -r -d '' result < "$FP_TMP/$i.out" || true
        src=""; vrc=""; read -r src vrc <<< "${result##*$'\n'}"
        body="${result%$'\n'*}"
        details=""
        if [[ "$vrc" == 0 && "$src" == [012] && "${body%%$'\n'*}" == "$src" ]]; then
            rc=$src; node_status="${LEVELS[rc]}"
            body="${body#*$'\n'}"; body="${body%$'\n'}"
            nodes+="${nodes:+,}${body%%$'\n'*}"
            [[ "$body" != *$'\n'* ]] || details="${body#*$'\n'}"
        else
            rc=2; node_status=crit
            if [[ "$src" == 255 ]]; then error="ssh failed with exit 255"
            elif [[ "$vrc" == 2 || "$src" == [012] ]]; then error="invalid remote report (exit $src)"
            else error="remote run failed with exit $src"; fi
            err_detail "$FP_TMP/$i.err"; detail="$REPLY"
            jstr "${hosts[i]}"; nodes+="${nodes:+,}{\"node-healthcheck\":\"$NHC_VERSION\",\"host\":$REPLY"
            nodes+=",\"status\":\"crit\",\"exit_code\":2,\"error\":\"$error\""
            if [[ -n "$detail" ]]; then jstr "$detail"; nodes+=",\"detail\":$REPLY"; fi
            nodes+=",\"checks\":[]}"
            details="    $error${detail:+: $detail}"
        fi
        if (( rc > worst )); then worst=$rc; worst_status=$node_status; fi
        # --quiet prints only the nodes that are not ok.
        if (( ! JSON )) && { (( ! QUIET )) || [[ "$node_status" != ok ]]; }; then
            paint "$node_status"
            out '%s[%-4s]%s %s\n' "$C" "${node_status^^}" "$R" "${hosts[i]}"
            [[ "$node_status" == ok || -z "$details" ]] || out '%s\n' "$details"
        fi
    done
    if (( JSON )); then
        now_utc
        out '{"node-healthcheck":"%s","timestamp":"%s","status":"%s","exit_code":%d,"nodes":[%s]}\n' \
            "$NHC_VERSION" "$NOW" "$worst_status" "$worst" "$nodes"
    else
        paint "$worst_status"
        out '\nOverall: %s%s%s (exit %d)\n' "$C" "${worst_status^^}" "$R" "$worst"
    fi
    finish "$worst"
}

if [[ -n "$HOSTS" ]]; then run_remote; else run_local; fi
