#!/usr/bin/env bash
# node-healthcheck: single-script Linux host health check with JSON output,
# meaningful exit codes, and multi-node SSH aggregation.
#
# Exit codes: 0 healthy, 1 warning, 2 critical, 3 usage or runtime error.
#
# Copyright (c) 2026 Greyforge (https://greyforge.tech)
# SPDX-License-Identifier: AGPL-3.0-only

# Checks are dispatched dynamically as "check_$name", which shellcheck cannot follow.
# shellcheck disable=SC2329,SC2317

set -euo pipefail

NHC_VERSION="1.0.0"

# Roots are overridable so the check logic can be exercised against fixtures.
PROC_ROOT="${NODE_HEALTHCHECK_PROC:-/proc}"
FS_ROOT="${NODE_HEALTHCHECK_ROOT:-}"

ALL_CHECKS="system load memory swap disk inodes network gateway dns services user_services ports peers failed_units time_sync reboot_required sessions zombies"

# Thresholds (percent used unless noted). Load thresholds are multiples of core count.
WARN_LOAD="1.0"; CRIT_LOAD="2.0"
WARN_MEM="80";  CRIT_MEM="95"
WARN_SWAP="50"; CRIT_SWAP="90"
WARN_DISK="80"; CRIT_DISK="90"
WARN_INODES="80"; CRIT_INODES="90"
WARN_ZOMBIES="5"; CRIT_ZOMBIES="50"

SERVICES=""; USER_SERVICES=""; PORTS=""; PEERS=""; DNS_NAME=""; MOUNTS=""
CHECKS=""; SKIP=""; HOSTS=""
JSON=0; QUIET=0; COLOR=1; PING_TIMEOUT="1"; SSH_TIMEOUT="10"; SSH_OPTS=""
CONFIG_FILE=""

usage() {
    cat <<USAGE
node-healthcheck ${NHC_VERSION}

Usage: node-healthcheck [options]

Output:
  --json                 Emit a JSON document instead of text
  --quiet                Text mode: print only warn/crit checks and the summary
  --no-color             Disable ANSI colours in text mode

Selection:
  --check LIST           Comma-separated checks to run (default: all)
  --skip LIST            Comma-separated checks to skip
  --config FILE          key=value config file (see examples/node-healthcheck.conf)

Targets:
  --services LIST        systemd system units expected active
  --user-services LIST   systemd user units expected active
  --ports LIST           TCP ports expected to be listening
  --peers LIST           Hosts expected to answer ping
  --dns NAME             Hostname that must resolve
  --mounts LIST          Mount points to check (default: all local filesystems)
  --host HOST            Run remotely over SSH (repeatable; implies aggregation)
  --ssh-opts "OPTS"      Extra ssh options for --host
  --ssh-timeout SECONDS  ssh ConnectTimeout (default: ${SSH_TIMEOUT})
  --ping-timeout SECONDS ping wait per peer (default: ${PING_TIMEOUT})

Thresholds:
  --warn-load N --crit-load N        load1 per core (default ${WARN_LOAD} / ${CRIT_LOAD})
  --warn-mem % --crit-mem %          memory used (default ${WARN_MEM} / ${CRIT_MEM})
  --warn-swap % --crit-swap %        swap used (default ${WARN_SWAP} / ${CRIT_SWAP})
  --warn-disk % --crit-disk %        disk used (default ${WARN_DISK} / ${CRIT_DISK})
  --warn-inodes % --crit-inodes %    inodes used (default ${WARN_INODES} / ${CRIT_INODES})
  --warn-zombies N --crit-zombies N  zombie processes (default ${WARN_ZOMBIES} / ${CRIT_ZOMBIES})

Checks: ${ALL_CHECKS}

Exit codes: 0 healthy, 1 warning, 2 critical, 3 usage or runtime error.
USAGE
}

die() { echo "node-healthcheck: $*" >&2; exit 3; }

# ── Config file (parsed, never sourced) ──────────────────────────────────────

load_config() {
    local file="$1" line key value
    [[ -r "$file" ]] || die "cannot read config file: $file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" == *=* ]] || die "config line is not key=value: $line"
        key="${line%%=*}"; value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%\"}"; value="${value#\"}"
        case "$key" in
            services) SERVICES="$value" ;;
            user_services) USER_SERVICES="$value" ;;
            ports) PORTS="$value" ;;
            peers) PEERS="$value" ;;
            dns) DNS_NAME="$value" ;;
            mounts) MOUNTS="$value" ;;
            checks) CHECKS="$value" ;;
            skip) SKIP="$value" ;;
            hosts) HOSTS="$value" ;;
            ssh_opts) SSH_OPTS="$value" ;;
            ssh_timeout) SSH_TIMEOUT="$value" ;;
            ping_timeout) PING_TIMEOUT="$value" ;;
            warn_load) WARN_LOAD="$value" ;;   crit_load) CRIT_LOAD="$value" ;;
            warn_mem) WARN_MEM="$value" ;;     crit_mem) CRIT_MEM="$value" ;;
            warn_swap) WARN_SWAP="$value" ;;   crit_swap) CRIT_SWAP="$value" ;;
            warn_disk) WARN_DISK="$value" ;;   crit_disk) CRIT_DISK="$value" ;;
            warn_inodes) WARN_INODES="$value" ;; crit_inodes) CRIT_INODES="$value" ;;
            warn_zombies) WARN_ZOMBIES="$value" ;; crit_zombies) CRIT_ZOMBIES="$value" ;;
            *) die "unknown config key: $key" ;;
        esac
    done < "$file"
}

# ── Argument parsing ─────────────────────────────────────────────────────────

need_value() { [[ $# -ge 2 ]] || die "$1 requires a value"; }

ORIGINAL_ARGS=("$@")
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -V|--version) echo "node-healthcheck ${NHC_VERSION}"; exit 0 ;;
        --json) JSON=1 ;;
        --quiet) QUIET=1 ;;
        --no-color) COLOR=0 ;;
        --config) need_value "$@"; CONFIG_FILE="$2"; load_config "$2"; shift ;;
        --check) need_value "$@"; CHECKS="$2"; shift ;;
        --skip) need_value "$@"; SKIP="$2"; shift ;;
        --services) need_value "$@"; SERVICES="$2"; shift ;;
        --user-services) need_value "$@"; USER_SERVICES="$2"; shift ;;
        --ports) need_value "$@"; PORTS="$2"; shift ;;
        --peers) need_value "$@"; PEERS="$2"; shift ;;
        --dns) need_value "$@"; DNS_NAME="$2"; shift ;;
        --mounts) need_value "$@"; MOUNTS="$2"; shift ;;
        --host) need_value "$@"; HOSTS="${HOSTS:+$HOSTS,}$2"; shift ;;
        --ssh-opts) need_value "$@"; SSH_OPTS="$2"; shift ;;
        --ssh-timeout) need_value "$@"; SSH_TIMEOUT="$2"; shift ;;
        --ping-timeout) need_value "$@"; PING_TIMEOUT="$2"; shift ;;
        --warn-load) need_value "$@"; WARN_LOAD="$2"; shift ;;
        --crit-load) need_value "$@"; CRIT_LOAD="$2"; shift ;;
        --warn-mem) need_value "$@"; WARN_MEM="$2"; shift ;;
        --crit-mem) need_value "$@"; CRIT_MEM="$2"; shift ;;
        --warn-swap) need_value "$@"; WARN_SWAP="$2"; shift ;;
        --crit-swap) need_value "$@"; CRIT_SWAP="$2"; shift ;;
        --warn-disk) need_value "$@"; WARN_DISK="$2"; shift ;;
        --crit-disk) need_value "$@"; CRIT_DISK="$2"; shift ;;
        --warn-inodes) need_value "$@"; WARN_INODES="$2"; shift ;;
        --crit-inodes) need_value "$@"; CRIT_INODES="$2"; shift ;;
        --warn-zombies) need_value "$@"; WARN_ZOMBIES="$2"; shift ;;
        --crit-zombies) need_value "$@"; CRIT_ZOMBIES="$2"; shift ;;
        --) shift; break ;;
        -*) die "unknown option: $1 (see --help)" ;;
        *) die "unexpected argument: $1" ;;
    esac
    shift
done

is_number() { [[ "$1" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; }
is_int() { [[ "$1" =~ ^[0-9]+$ ]]; }

for pair in "WARN_LOAD:$WARN_LOAD" "CRIT_LOAD:$CRIT_LOAD" "WARN_MEM:$WARN_MEM" "CRIT_MEM:$CRIT_MEM" \
            "WARN_SWAP:$WARN_SWAP" "CRIT_SWAP:$CRIT_SWAP" "WARN_DISK:$WARN_DISK" "CRIT_DISK:$CRIT_DISK" \
            "WARN_INODES:$WARN_INODES" "CRIT_INODES:$CRIT_INODES" "PING_TIMEOUT:$PING_TIMEOUT" "SSH_TIMEOUT:$SSH_TIMEOUT"; do
    is_number "${pair#*:}" || die "${pair%%:*} must be numeric, got '${pair#*:}'"
done
for pair in "WARN_ZOMBIES:$WARN_ZOMBIES" "CRIT_ZOMBIES:$CRIT_ZOMBIES"; do
    is_int "${pair#*:}" || die "${pair%%:*} must be an integer, got '${pair#*:}'"
done

# ── Check selection ──────────────────────────────────────────────────────────

split_list() {
    # Comma or whitespace separated -> one item per line, blanks dropped.
    local IFS=$', \t\n'
    for item in $1; do printf '%s\n' "$item"; done
}

known_check() {
    local c
    for c in $ALL_CHECKS; do [[ "$c" == "$1" ]] && return 0; done
    return 1
}

SELECTED=()
if [[ -n "$CHECKS" ]]; then
    while IFS= read -r c; do
        known_check "$c" || die "unknown check: $c"
        SELECTED+=("$c")
    done < <(split_list "$CHECKS")
else
    for c in $ALL_CHECKS; do SELECTED+=("$c"); done
fi
if [[ -n "$SKIP" ]]; then
    while IFS= read -r s; do
        known_check "$s" || die "unknown check in --skip: $s"
        filtered=()
        for c in "${SELECTED[@]}"; do [[ "$c" != "$s" ]] && filtered+=("$c"); done
        SELECTED=("${filtered[@]+"${filtered[@]}"}")
    done < <(split_list "$SKIP")
fi

# ── JSON helpers (no jq dependency) ──────────────────────────────────────────

json_str() {
    # Escape a string for JSON. Control characters other than \n \r \t are
    # rare in this output and are dropped rather than emitted raw.
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    s="$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')"
    printf '"%s"' "$s"
}

json_val() {
    if is_number "$1"; then printf '%s' "$1"; else json_str "$1"; fi
}

# ── Result accumulation ──────────────────────────────────────────────────────

CHECK_JSON=()
OVERALL=0            # 0 ok, 1 warn, 2 crit
WORST_STATUS="ok"

status_rank() {
    case "$1" in ok|info|skip) echo 0 ;; warn) echo 1 ;; crit) echo 2 ;; *) echo 0 ;; esac
}

# record NAME STATUS SUMMARY [key=value ...]
record() {
    local name="$1" status="$2" summary="$3"; shift 3
    local rank; rank="$(status_rank "$status")"
    if (( rank > OVERALL )); then OVERALL=$rank; WORST_STATUS="$status"; fi

    local metrics="" first=1 kv key value
    for kv in "$@"; do
        key="${kv%%=*}"; value="${kv#*=}"
        (( first )) || metrics+=","
        first=0
        metrics+="$(json_str "$key"):$(json_val "$value")"
    done
    CHECK_JSON+=("{\"name\":$(json_str "$name"),\"status\":$(json_str "$status"),\"summary\":$(json_str "$summary"),\"metrics\":{${metrics}}}")

    if (( ! JSON )); then
        if (( QUIET )) && [[ "$status" != "warn" && "$status" != "crit" ]]; then return; fi
        local tag="$status" c_reset="" c=""
        if (( COLOR )); then
            c_reset=$'\033[0m'
            case "$status" in
                ok) c=$'\033[32m' ;; warn) c=$'\033[33m' ;; crit) c=$'\033[31m' ;;
                info) c=$'\033[36m' ;; skip) c=$'\033[90m' ;;
            esac
        fi
        printf '%s[%-4s]%s %-16s %s\n' "$c" "${tag^^}" "$c_reset" "$name" "$summary"
    fi
}

# Threshold helper: compare a value against warn/crit (higher is worse).
# Prints ok|warn|crit.
level_for() {
    local value="$1" warn="$2" crit="$3"
    awk -v v="$value" -v w="$warn" -v c="$crit" 'BEGIN {
        if (v + 0 >= c + 0) print "crit"; else if (v + 0 >= w + 0) print "warn"; else print "ok" }'
}

has() { command -v "$1" >/dev/null 2>&1; }

# ── Checks ───────────────────────────────────────────────────────────────────

check_system() {
    local host kernel uptime_s uptime_h
    host="$(hostname 2>/dev/null || echo unknown)"
    kernel="$(uname -r 2>/dev/null || echo unknown)"
    if [[ -r "$PROC_ROOT/uptime" ]]; then
        uptime_s="$(awk '{printf "%d", $1}' "$PROC_ROOT/uptime")"
    else
        uptime_s=0
    fi
    uptime_h="$(awk -v s="$uptime_s" 'BEGIN { d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60);
        if (d>0) printf "%dd %dh %dm", d, h, m; else if (h>0) printf "%dh %dm", h, m; else printf "%dm", m }')"
    record system ok "$host, kernel $kernel, up $uptime_h" "hostname=$host" "kernel=$kernel" "uptime_seconds=$uptime_s"
}

check_load() {
    [[ -r "$PROC_ROOT/loadavg" ]] || { record load skip "loadavg unavailable"; return; }
    local l1 l5 l15 cores per_core level
    read -r l1 l5 l15 _ < "$PROC_ROOT/loadavg"
    cores="$(nproc 2>/dev/null || echo 1)"
    is_int "$cores" && (( cores > 0 )) || cores=1
    per_core="$(awk -v l="$l1" -v c="$cores" 'BEGIN { printf "%.2f", l / c }')"
    level="$(level_for "$per_core" "$WARN_LOAD" "$CRIT_LOAD")"
    record load "$level" "$l1 $l5 $l15 on $cores cores (${per_core}/core)" "load1=$l1" "load5=$l5" "load15=$l15" "cores=$cores" "load1_per_core=$per_core"
}

meminfo_kb() { awk -v k="$1" '$1 == k":" { print $2; exit }' "$PROC_ROOT/meminfo"; }

check_memory() {
    [[ -r "$PROC_ROOT/meminfo" ]] || { record memory skip "meminfo unavailable"; return; }
    local total avail used pct level
    total="$(meminfo_kb MemTotal)"; avail="$(meminfo_kb MemAvailable)"
    [[ -n "$total" && -n "$avail" && "$total" != 0 ]] || { record memory skip "meminfo incomplete"; return; }
    used=$(( total - avail ))
    pct="$(awk -v u="$used" -v t="$total" 'BEGIN { printf "%.1f", u * 100 / t }')"
    level="$(level_for "$pct" "$WARN_MEM" "$CRIT_MEM")"
    record memory "$level" "${pct}% used ($(( used / 1024 )) MiB of $(( total / 1024 )) MiB)" "used_percent=$pct" "total_kb=$total" "available_kb=$avail"
}

check_swap() {
    [[ -r "$PROC_ROOT/meminfo" ]] || { record swap skip "meminfo unavailable"; return; }
    local total free used pct level
    total="$(meminfo_kb SwapTotal)"; free="$(meminfo_kb SwapFree)"
    if [[ -z "$total" || "$total" == 0 ]]; then record swap info "no swap configured" "total_kb=0"; return; fi
    used=$(( total - free ))
    pct="$(awk -v u="$used" -v t="$total" 'BEGIN { printf "%.1f", u * 100 / t }')"
    level="$(level_for "$pct" "$WARN_SWAP" "$CRIT_SWAP")"
    record swap "$level" "${pct}% used ($(( used / 1024 )) MiB of $(( total / 1024 )) MiB)" "used_percent=$pct" "total_kb=$total" "free_kb=$free"
}

# df -P output lines for local filesystems (or the requested mount points).
df_lines() {
    local flag="$1"
    if [[ -n "$MOUNTS" ]]; then
        local m
        while IFS= read -r m; do df -P "$flag" -- "$m" 2>/dev/null | awk 'NR == 2'; done < <(split_list "$MOUNTS")
    else
        df -P "$flag" -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs -x fuse.portal 2>/dev/null | awk 'NR > 1'
    fi
}

check_fs_usage() {
    local name="$1" flag="$2" warn="$3" crit="$4" unit="$5"
    local worst="ok" summary="" count=0 metrics=() line mount pct level
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        mount="$(awk '{print $NF}' <<< "$line")"
        pct="$(awk '{print $(NF-1)}' <<< "$line")"; pct="${pct%\%}"
        is_int "$pct" || continue
        count=$(( count + 1 ))
        level="$(level_for "$pct" "$warn" "$crit")"
        metrics+=("${mount}=${pct}")
        if (( $(status_rank "$level") > $(status_rank "$worst") )); then worst="$level"; fi
        if [[ "$level" != "ok" ]]; then summary+="${summary:+, }${mount} ${pct}%"; fi
    done < <(df_lines "$flag")
    if (( count == 0 )); then record "$name" skip "no filesystems found"; return; fi
    if [[ -z "$summary" ]]; then summary="$count filesystem(s) under ${warn}% $unit"; fi
    record "$name" "$worst" "$summary" "${metrics[@]}"
}

check_disk() { check_fs_usage disk "-k" "$WARN_DISK" "$CRIT_DISK" "used"; }
check_inodes() { check_fs_usage inodes "-i" "$WARN_INODES" "$CRIT_INODES" "inodes used"; }

check_network() {
    has ip || { record network skip "ip command unavailable"; return; }
    local ifaces="" count=0 line name addr
    while IFS= read -r line; do
        name="$(awk '{print $NF}' <<< "$line")"; addr="$(awk '{print $2}' <<< "$line")"
        [[ "$addr" == 127.* ]] && continue
        count=$(( count + 1 ))
        ifaces+="${ifaces:+, }${name} ${addr}"
    done < <(ip -4 -o addr show 2>/dev/null | awk '{print $2, $4, $2}')
    if (( count == 0 )); then record network warn "no non-loopback IPv4 address" "interfaces=0"; else record network ok "$ifaces" "interfaces=$count"; fi
}

check_gateway() {
    has ip || { record gateway skip "ip command unavailable"; return; }
    local gw
    gw="$(ip -4 route show default 2>/dev/null | awk '/default/ {print $3; exit}')"
    [[ -n "$gw" ]] || { record gateway warn "no default route" ; return; }
    has ping || { record gateway skip "ping unavailable" "gateway=$gw"; return; }
    if ping -c 1 -W "$PING_TIMEOUT" "$gw" >/dev/null 2>&1; then record gateway ok "$gw reachable" "gateway=$gw" "reachable=1"
    else record gateway crit "$gw unreachable" "gateway=$gw" "reachable=0"; fi
}

check_dns() {
    [[ -n "$DNS_NAME" ]] || { record dns skip "no --dns name configured"; return; }
    has getent || { record dns skip "getent unavailable"; return; }
    local resolved
    resolved="$(getent ahosts "$DNS_NAME" 2>/dev/null | awk 'NR == 1 {print $1}')"
    if [[ -n "$resolved" ]]; then record dns ok "$DNS_NAME -> $resolved" "name=$DNS_NAME" "address=$resolved"
    else record dns crit "$DNS_NAME does not resolve" "name=$DNS_NAME"; fi
}

check_units() {
    local name="$1" list="$2"
    local -a scope=()
    [[ -n "$3" ]] && scope=("$3")
    [[ -n "$list" ]] || { record "$name" skip "none configured"; return; }
    has systemctl || { record "$name" skip "systemctl unavailable"; return; }
    local unit down="" up=0 total=0 metrics=()
    while IFS= read -r unit; do
        total=$(( total + 1 ))
        if systemctl "${scope[@]+"${scope[@]}"}" is-active --quiet -- "$unit" 2>/dev/null; then up=$(( up + 1 )); metrics+=("${unit}=1")
        else down+="${down:+, }${unit}"; metrics+=("${unit}=0"); fi
    done < <(split_list "$list")
    if [[ -z "$down" ]]; then record "$name" ok "$up/$total active" "${metrics[@]}"
    else record "$name" crit "inactive: $down ($up/$total active)" "${metrics[@]}"; fi
}

check_services() { check_units services "$SERVICES" ""; }
check_user_services() { check_units user_services "$USER_SERVICES" "--user"; }

listening_ports() {
    if has ss; then ss -Hltn 2>/dev/null | awk '{print $4}' | sed 's/.*://' | sort -u
    elif has netstat; then netstat -ltn 2>/dev/null | awk 'NR > 2 {print $4}' | sed 's/.*://' | sort -u
    fi
}

check_ports() {
    [[ -n "$PORTS" ]] || { record ports skip "none configured"; return; }
    if ! has ss && ! has netstat; then record ports skip "ss and netstat unavailable"; return; fi
    local open port missing="" up=0 total=0 metrics=()
    open="$(listening_ports)"
    while IFS= read -r port; do
        is_int "$port" || die "invalid port: $port"
        total=$(( total + 1 ))
        if grep -qx "$port" <<< "$open"; then up=$(( up + 1 )); metrics+=("${port}=1")
        else missing+="${missing:+, }${port}"; metrics+=("${port}=0"); fi
    done < <(split_list "$PORTS")
    if [[ -z "$missing" ]]; then record ports ok "$up/$total listening" "${metrics[@]}"
    else record ports crit "not listening: $missing ($up/$total)" "${metrics[@]}"; fi
}

check_peers() {
    [[ -n "$PEERS" ]] || { record peers skip "none configured"; return; }
    has ping || { record peers skip "ping unavailable"; return; }
    local peer down="" up=0 total=0 metrics=()
    while IFS= read -r peer; do
        total=$(( total + 1 ))
        if ping -c 1 -W "$PING_TIMEOUT" -- "$peer" >/dev/null 2>&1; then up=$(( up + 1 )); metrics+=("${peer}=1")
        else down+="${down:+, }${peer}"; metrics+=("${peer}=0"); fi
    done < <(split_list "$PEERS")
    if [[ -z "$down" ]]; then record peers ok "$up/$total reachable" "${metrics[@]}"
    else record peers crit "unreachable: $down ($up/$total)" "${metrics[@]}"; fi
}

check_failed_units() {
    has systemctl || { record failed_units skip "systemctl unavailable"; return; }
    local failed count
    failed="$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}' | grep -v '^$' || true)"
    count="$(grep -c . <<< "$failed" || true)"
    [[ -z "$failed" ]] && count=0
    if (( count == 0 )); then record failed_units ok "no failed units" "count=0"
    else record failed_units warn "$count failed: $(tr '\n' ' ' <<< "$failed" | sed 's/ $//')" "count=$count"; fi
}

check_time_sync() {
    has timedatectl || { record time_sync skip "timedatectl unavailable"; return; }
    local synced
    synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    case "$synced" in
        yes) record time_sync ok "clock synchronized" "synchronized=1" ;;
        no) record time_sync warn "clock not synchronized" "synchronized=0" ;;
        *) record time_sync skip "timedatectl gave no answer" ;;
    esac
}

check_reboot_required() {
    if [[ -e "$FS_ROOT/var/run/reboot-required" || -e "$FS_ROOT/run/reboot-required" ]]; then
        local pkgs=""
        [[ -r "$FS_ROOT/var/run/reboot-required.pkgs" ]] && pkgs="$(tr '\n' ' ' < "$FS_ROOT/var/run/reboot-required.pkgs" | sed 's/ $//')"
        record reboot_required warn "reboot required${pkgs:+ ($pkgs)}" "required=1"
    else
        record reboot_required ok "no reboot pending" "required=0"
    fi
}

check_sessions() {
    has who || { record sessions skip "who unavailable"; return; }
    local count
    count="$(who 2>/dev/null | grep -c . || true)"
    record sessions info "$count login session(s)" "count=$count"
}

check_zombies() {
    [[ -d "$PROC_ROOT" ]] || { record zombies skip "proc unavailable"; return; }
    local count level
    count="$(grep -sh '^State:' "$PROC_ROOT"/[0-9]*/status 2>/dev/null | grep -c 'Z' || true)"
    level="$(level_for "$count" "$WARN_ZOMBIES" "$CRIT_ZOMBIES")"
    record zombies "$level" "$count zombie process(es)" "count=$count"
}

# ── Local run ────────────────────────────────────────────────────────────────

emit_local_json() {
    local ts host joined="" first=1 item
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    host="$(hostname 2>/dev/null || echo unknown)"
    for item in "${CHECK_JSON[@]+"${CHECK_JSON[@]}"}"; do
        (( first )) || joined+=","
        first=0
        joined+="$item"
    done
    printf '{"node-healthcheck":%s,"host":%s,"timestamp":%s,"status":%s,"exit_code":%d,"checks":[%s]}\n' \
        "$(json_str "$NHC_VERSION")" "$(json_str "$host")" "$(json_str "$ts")" "$(json_str "$WORST_STATUS")" "$OVERALL" "$joined"
}

run_local() {
    local c
    if (( ! JSON )); then
        printf 'node-healthcheck %s - %s - %s\n\n' "$NHC_VERSION" "$(hostname 2>/dev/null || echo unknown)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi
    for c in "${SELECTED[@]+"${SELECTED[@]}"}"; do "check_$c"; done
    if (( JSON )); then
        emit_local_json
    else
        local c_reset="" c=""
        if (( COLOR )); then c_reset=$'\033[0m'; case "$WORST_STATUS" in ok) c=$'\033[32m' ;; warn) c=$'\033[33m' ;; crit) c=$'\033[31m' ;; esac; fi
        printf '\nOverall: %s%s%s (exit %d)\n' "$c" "${WORST_STATUS^^}" "$c_reset" "$OVERALL"
    fi
    exit "$OVERALL"
}

# ── Multi-node run ───────────────────────────────────────────────────────────

remote_args() {
    # Forward everything except host selection and output mode; force --json.
    local args=() skip_next=0 a
    for a in "${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"}"; do
        if (( skip_next )); then skip_next=0; continue; fi
        case "$a" in
            --host|--ssh-opts|--ssh-timeout|--config) skip_next=1 ;;
            --json|--quiet|--no-color) ;;
            *) args+=("$a") ;;
        esac
    done
    # A config file is local; re-express its target lists explicitly for the remote.
    if [[ -n "$CONFIG_FILE" ]]; then
        [[ -n "$SERVICES" ]] && args+=(--services "$SERVICES")
        [[ -n "$USER_SERVICES" ]] && args+=(--user-services "$USER_SERVICES")
        [[ -n "$PORTS" ]] && args+=(--ports "$PORTS")
        [[ -n "$PEERS" ]] && args+=(--peers "$PEERS")
        [[ -n "$DNS_NAME" ]] && args+=(--dns "$DNS_NAME")
        [[ -n "$MOUNTS" ]] && args+=(--mounts "$MOUNTS")
        [[ -n "$CHECKS" ]] && args+=(--check "$CHECKS")
        [[ -n "$SKIP" ]] && args+=(--skip "$SKIP")
        args+=(--warn-load "$WARN_LOAD" --crit-load "$CRIT_LOAD" --warn-mem "$WARN_MEM" --crit-mem "$CRIT_MEM"
               --warn-swap "$WARN_SWAP" --crit-swap "$CRIT_SWAP" --warn-disk "$WARN_DISK" --crit-disk "$CRIT_DISK"
               --warn-inodes "$WARN_INODES" --crit-inodes "$CRIT_INODES" --warn-zombies "$WARN_ZOMBIES" --crit-zombies "$CRIT_ZOMBIES"
               --ping-timeout "$PING_TIMEOUT")
    fi
    args+=(--json)
    printf '%q ' "${args[@]}"
}

run_remote() {
    has ssh || die "ssh is required for --host"
    local host output rc nodes="" first=1 node_status node_exit worst=0 worst_status="ok" args
    args="$(remote_args)"
    # shellcheck disable=SC2086
    while IFS= read -r host; do
        set +e
        output="$(ssh -o BatchMode=yes -o ConnectTimeout="$SSH_TIMEOUT" $SSH_OPTS -- "$host" "bash -s -- $args" < "${BASH_SOURCE[0]}" 2>/dev/null)"
        rc=$?
        set -e
        if (( rc == 0 || rc == 1 || rc == 2 )) && [[ "$output" == \{* ]]; then
            node_exit=$rc
            case "$rc" in 0) node_status=ok ;; 1) node_status=warn ;; *) node_status=crit ;; esac
            (( first )) || nodes+=","
            first=0
            nodes+="$output"
        else
            node_exit=2; node_status=crit
            (( first )) || nodes+=","
            first=0
            nodes+="{\"node-healthcheck\":$(json_str "$NHC_VERSION"),\"host\":$(json_str "$host"),\"status\":\"crit\",\"exit_code\":2,\"error\":$(json_str "ssh failed with exit $rc"),\"checks\":[]}"
        fi
        if (( node_exit > worst )); then worst=$node_exit; worst_status=$node_status; fi
        if (( ! JSON )); then
            local c_reset="" c=""
            if (( COLOR )); then c_reset=$'\033[0m'; case "$node_status" in ok) c=$'\033[32m' ;; warn) c=$'\033[33m' ;; crit) c=$'\033[31m' ;; esac; fi
            printf '%s[%-4s]%s %s\n' "$c" "${node_status^^}" "$c_reset" "$host"
            if [[ "$node_status" != "ok" && "$output" == \{* ]]; then
                # Surface the failing checks without a JSON parser: one summary per non-ok check.
                grep -o '{"name":"[^"]*","status":"\(warn\|crit\)","summary":"[^"]*"' <<< "$output" \
                    | sed -E 's/\{"name":"([^"]*)","status":"([^"]*)","summary":"([^"]*)"/    [\2] \1: \3/' || true
            elif [[ "$node_status" != "ok" ]]; then
                printf '    ssh failed with exit %d\n' "$rc"
            fi
        fi
    done < <(split_list "$HOSTS")
    if (( JSON )); then
        printf '{"node-healthcheck":%s,"timestamp":%s,"status":%s,"exit_code":%d,"nodes":[%s]}\n' \
            "$(json_str "$NHC_VERSION")" "$(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" "$(json_str "$worst_status")" "$worst" "$nodes"
    else
        printf '\nOverall: %s (exit %d)\n' "${worst_status^^}" "$worst"
    fi
    exit "$worst"
}

if [[ -n "$HOSTS" ]]; then run_remote; else run_local; fi
